<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="exec.ItemMapper">

  <select id="find" resultType="map">
    SELECT id, name FROM items
    <where>
      <if test="ids != null">
        id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
      </if>
    </where>
    ORDER BY id
  </select>

  <insert id="insert">
    INSERT INTO items (id, name) VALUES (#{id}, #{name})
  </insert>

  <insert id="insertWithKey">
    <selectKey keyProperty="id" resultType="long" order="BEFORE">SELECT 1</selectKey>
    INSERT INTO items (id, name) VALUES (#{id}, #{name})
  </insert>

  <update id="broken">
    UPDATE no_such_table SET name = #{name}
  </update>
</mapper>
